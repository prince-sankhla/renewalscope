{
  "name": "procore-renewal-engine",
  "version": "1.0.0",
  "description": "Evidence-driven Procore renewal optimization engine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:ui": "esbuild src/ui.ts --bundle --outfile=public/bundle.js --platform=browser --target=es2020 --minify",
    "dev": "esbuild src/ui.ts --bundle --outfile=public/bundle.js --platform=browser --target=es2020 --watch",
    "test": "tsc && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
